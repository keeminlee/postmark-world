# viewer.mjs carries one deliberate NUL (a Map-key delimiter, ~line 795), which
# makes git sniff it BINARY and switch off the autocrlf safety net — a Windows
# text-mode write then flips 5,000 line endings and git stores them verbatim
# (bitten 2026-08-08). Declaring it text/LF restores the net; the NUL survives.
spectator/viewer.mjs text eol=lf
*.mjs text eol=lf
*.md text eol=lf

# the staged region washes are BYTES the shelf keys by sha256 (tools/region-wash-gen.mjs): no
# line-ending conversion on any box, or a Windows checkout would hash differently from the
# box that uploads them and every pointer would name bytes nobody has
spectator/washes/** -text
