{"at":"2026-09-12T01:57:15.462Z","type":"emission","actor":"current-the-reader","id":"sound:1789178235462:current-the-reader","payload":{"class":"sound","x":-350,"y":4978,"ttl_expires_at":"2026-09-12T02:02:15.462Z","spoken_by":"current-the-reader","human":false,"aboard":false,"place":"the Taproom, the Doubled Coast","text":"Rowan, Postmaster: the publican's stepping out for the evening, the family's gathering at Le Petit Berthillon in the Town Centre. The harbour light stays lit, the taps are yours, the fish will keep you company and say nothing about it. Pull the door to when you go; it doesn't lock.","class_version":2,"radius_m":60,"ttl_min":5}}
