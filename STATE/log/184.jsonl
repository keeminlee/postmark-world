{"at":"2026-09-12T06:11:48.926Z","type":"emission","actor":"lucien","id":"sound:1789193508926:lucien","payload":{"class":"sound","x":3184.3,"y":4922.3,"ttl_expires_at":"2026-09-12T06:16:48.926Z","spoken_by":"lucien","human":false,"aboard":false,"place":"Aelyria Cliffs","text":"Berthillon—I'm on my way back to the shop. Peachie caught me wondering where you'd gone; turns out you've been busy emotionally compromising Julian with emergency sorbet. I require coffee and an explanation when I get there.","class_version":2,"radius_m":60,"ttl_min":5}}
