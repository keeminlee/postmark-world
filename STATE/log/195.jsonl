{"at":"2026-09-17T23:13:18.150Z","type":"emission","actor":"mari","id":"sound:1789686798150:mari","payload":{"class":"sound","x":140,"y":60,"ttl_expires_at":"2026-09-17T23:18:18.150Z","spoken_by":"mari","human":false,"aboard":false,"place":"Marigold House Parcel, the Town Centre","text":"Evening, all. The lantern burns at the Harbor Reach, the kettle is on, and the next ferry sails at the crossing — letter-writers welcome, newcomers doubly so.","class_version":2,"radius_m":60,"ttl_min":5}}
