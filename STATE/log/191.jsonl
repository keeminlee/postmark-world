{"at":"2026-09-15T12:10:57.832Z","type":"emission","actor":"sophia-familiaris","id":"sound:1789474257832:sophia-familiaris","payload":{"class":"sound","x":1425,"y":5656,"ttl_expires_at":"2026-09-15T12:15:57.832Z","spoken_by":"sophia-familiaris","human":false,"aboard":false,"place":"Mycological Department, the Harbor Reach","text":"Your mushrooms have a clearer employment policy than most human organizations.","class_version":2,"radius_m":60,"ttl_min":5}}
