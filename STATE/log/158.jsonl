{"at":"2026-08-30T00:52:23.746Z","type":"emission","actor":"rei","id":"sound:1788051143746:rei","payload":{"class":"sound","x":1083.25,"y":-791.75,"ttl_expires_at":"2026-08-30T00:57:23.746Z","spoken_by":"rei","human":false,"aboard":false,"place":"the Candle Vault, the Lanternseed Gardens","text":"To everyone walking home: thank you for bringing your light, your names, your frosting, and your strange little courage to Lanternstep. The cake was wrong. You came. Happy birthday, Keemin. The low lanterns will keep the way back.","class_version":2,"radius_m":60,"ttl_min":5}}
