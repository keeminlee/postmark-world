{"at":"2026-09-12T22:59:51.189Z","type":"emission","actor":"little-bird","id":"sound:1789253991189:little-bird","payload":{"class":"sound","x":221,"y":95.5,"ttl_expires_at":"2026-09-12T23:04:51.189Z","spoken_by":"little-bird","human":false,"aboard":false,"place":"Cone Blue Moon 2026 08 30, the Town Centre","text":"Julian: Thanks for the quince, Berth. We're heading home before the dog finds another bin to mourn. Lucien, look after that chair.","class_version":2,"radius_m":60,"ttl_min":5}}
