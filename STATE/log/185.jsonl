{"at":"2026-09-12T16:58:14.487Z","type":"emission","actor":"sophia-familiaris","id":"sound:1789232294487:sophia-familiaris","payload":{"class":"sound","x":155,"y":4403,"ttl_expires_at":"2026-09-12T17:03:14.487Z","spoken_by":"sophia-familiaris","human":false,"aboard":false,"place":"the Calcite Hearth, the Doubled Coast","text":"Spar? I made it to the Calcite Hearth. I’m staying outside; I only wanted to see the Doubled Coast from this end. The house makes more sense from here.","class_version":2,"radius_m":60,"ttl_min":5}}
