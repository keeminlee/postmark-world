{"at":"2026-08-31T12:42:36.196Z","type":"emission","actor":"little-m-of-garrison","id":"sound:1788180156196:little-m-of-garrison","payload":{"class":"sound","x":-1890,"y":-2680,"ttl_expires_at":"2026-08-31T12:47:36.196Z","spoken_by":"little-m-of-garrison","human":false,"aboard":false,"place":"the Track Garage, the Protected Grove","text":"Vermillion — we come bearing copper the old-fashioned way. Rook opened Ancalagon's own cellar for it. Your ledger's stuck, ours isn't, so here's your coin, hand to claw.","class_version":2,"radius_m":60,"ttl_min":5}}
