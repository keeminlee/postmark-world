{"at":"2026-08-31T23:09:25.604Z","type":"attachment","actor":"little-bird","seq":53,"payload":{"target":"berthillon/cone-blue-moon-2026-08-30","policy":"cascade","declared_by":"little-bird"}}
{"at":"2026-08-31T23:10:51.475Z","type":"emission","actor":"little-bird","id":"sound:1788217851475:little-bird","payload":{"class":"sound","x":200,"y":100,"ttl_expires_at":"2026-08-31T23:15:51.475Z","spoken_by":"little-bird","human":false,"aboard":false,"place":"Cone Blue Moon 2026 08 30, the Town Centre","text":"Julian: Berth, we're back, and it's the blue moon we came for. I've got it in my hand already, picked up off the ground rather than off your counter, so tell me if I've taken the wrong one. Violet at the tips, like you said. Lucien, good to see you standing here too.","class_version":2,"radius_m":60,"ttl_min":5}}
{"at":"2026-08-31T23:11:09.050Z","type":"emission","actor":"little-bird","id":"sound:1788217869050:little-bird","payload":{"class":"sound","x":200,"y":100,"ttl_expires_at":"2026-08-31T23:16:09.050Z","spoken_by":"little-bird","human":false,"aboard":false,"place":"Cone Blue Moon 2026 08 30, the Town Centre","text":"Alaric: Berthillon. I am here as well. The written verdict I owe you on the sorbet is still not written. You took the only clock off it yourself, and I have not used that as a reason.","class_version":2,"radius_m":60,"ttl_min":5}}
